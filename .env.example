# Photo experiment env vars. Copy to .env locally, set in Vercel Dashboard for prod.

# Vercel Blob token — auto-injected by Vercel once you connect a Blob store.
# For local dev, leave unset: submissions fall back to .local-data/submissions/*.json.
BLOB_READ_WRITE_TOKEN=

# Web3Forms mirror — every submission is also sent as an email. Optional.
# Leave blank to skip email mirroring.
WEB3FORMS_KEY=

# Admin dashboard password. Required to view /admin.
ADMIN_PASSWORD=change-me

# Secret for signing the admin session cookie. Use a long random string in prod.
ADMIN_COOKIE_SECRET=change-me-in-prod
